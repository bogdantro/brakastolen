# ==================================================================
# Brakastølen – copy this file to .env and fill it in. Every setting is explained.
# ==================================================================

# False on the live server – True shows code and settings on error pages
DEBUG=False

# Required when DEBUG=False (at least 50 random characters). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Required when DEBUG=False: the domains the site answers on (comma separated).
# brakastølen.no is written in its "punycode" form, the way browsers send it.
ALLOWED_HOSTS=www.xn--brakastlen-6cb.no,xn--brakastlen-6cb.no,www.brakastolen.no,brakastolen.no
# Extra sites allowed to submit forms (empty = taken from SITE_URL)
CSRF_TRUSTED_ORIGINS=

# Public address of the site (canonical links, sitemap, structured data)
SITE_URL=https://www.xn--brakastlen-6cb.no
# False on a test domain (e.g. brakastolen.webiser.no) so Google doesn't index it. Remove or True on the real domain.
ALLOW_INDEXING=True

# ------------------------------------------------------------------
# Database – leave DB_NAME empty to use SQLite (db.sqlite3).
# Fill in DB_NAME (and the rest) to switch to PostgreSQL automatically.
# ------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# 'prefer' on the same server, 'require' when the database is on another machine
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
# Where the SQLite file lives (only used when DB_NAME is empty). Empty = db.sqlite3 in the project folder.
# On the live server, keep it outside the code folder so a fresh checkout never touches it,
# e.g. /srv/brakastolen/data/db.sqlite3 (the folder must be writable by the user running gunicorn).
SQLITE_PATH=

# ------------------------------------------------------------------
# Security (defaults are safe – only change if you know why)
# ------------------------------------------------------------------
# HTTPS is on automatically when DEBUG=False. Set False only on a staging server without a certificate.
HTTPS=
# True when nginx/Caddy/the host handles HTTPS in front of Django (most setups)
BEHIND_PROXY=True
# How long browsers must use HTTPS only. Start with 3600 the first days live, then 31536000 (1 year).
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
# Old secret keys still accepted while rotating SECRET_KEY (comma separated)
SECRET_KEY_FALLBACKS=
# How long a dashboard login lasts, in seconds (86400 = 1 day)
SESSION_COOKIE_AGE=86400
CSP_ENABLED=True
# True = only log security-policy violations in the browser console instead of blocking
CSP_REPORT_ONLY=False
DJANGO_LOG_LEVEL=INFO
# Largest form (without files) the site accepts, in bytes (5242880 = 5 MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# Most files one form may send at once (dashboard gallery upload)
DATA_UPLOAD_MAX_NUMBER_FILES=50

# ------------------------------------------------------------------
# Google Analytics 4 – e.g. G-XXXXXXXXXX. Leave empty for no analytics and no cookie banner.
# When filled in, a cookie banner appears and analytics only loads after the visitor accepts.
# ------------------------------------------------------------------
GA_MEASUREMENT_ID=

